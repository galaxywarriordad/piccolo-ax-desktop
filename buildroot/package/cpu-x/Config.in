config BR2_PACKAGE_CPU_X
	bool "cpu-x"
	depends on BR2_i386 || BR2_x86_64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_NCURSES
	select BR2_PACKAGE_PCIUTILS
	select BR2_PACKAGE_PROCPS_NG
	help
	  System profiling and monitoring tool (CPU-Z equivalent)
	  displaying CPU clocks, caches, motherboard, memory, and
	  GPU/PCI hardware details in both GTK3 GUI and ncurses TUI.

	  https://github.com/TheTumultuousUnicornOfDarkness/CPU-X.git
